{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Vistrow Voice",
  "description": "AI voice agents that answer, qualify, and book calls in more than 130 languages, including Hindi, English and 9 other Indian languages.",
  "colors": {
    "primary": "#9333ea",
    "light": "#a855f7",
    "dark": "#7e22ce"
  },
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 700
    },
    "body": {
      "family": "Manrope"
    }
  },
  "background": {
    "color": {
      "light": "#f4f2f9",
      "dark": "#0a0a12"
    }
  },
  "appearance": {
    "default": "system"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/logo-light.png",
    "dark": "/logo/logo-dark.png",
    "href": "https://www.vistrowvoice.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Welcome",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Getting Started",
            "pages": [
              "quickstart",
              "platform/build-with-ai",
              "essentials/authentication"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "platform/agents",
              "platform/voices",
              "platform/knowledge-base",
              "platform/testing-lab"
            ]
          },
          {
            "group": "Deploy",
            "pages": [
              "platform/phone-numbers",
              "platform/website-widget",
              "platform/integrations",
              "platform/instant-lead-follow-up"
            ]
          },
          {
            "group": "Monitor",
            "pages": [
              "platform/calls",
              "platform/usage"
            ]
          },
          {
            "group": "Workspace",
            "pages": [
              "platform/settings",
              "platform/compliance",
              "platform/billing",
              "platform/copilot"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/agents",
              "api-reference/calls",
              "api-reference/knowledge-base",
              "api-reference/widget-sites"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Demo",
          "icon": "microphone",
          "href": "https://www.vistrowvoice.com/#live-demo"
        },
        {
          "anchor": "Website",
          "icon": "globe",
          "href": "https://www.vistrowvoice.com"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.vistrowvoice.com"
      },
      {
        "label": "Sign in",
        "href": "https://app.vistrowvoice.com/login"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Book a demo",
      "href": "https://www.vistrowvoice.com/contact"
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.vistrowvoice.com"
    },
    "links": [
      {
        "header": "Product",
