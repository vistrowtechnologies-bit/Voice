# STAGING_API_UPSTREAM is the staging backend, e.g. http://voice-staging.railway.internal:8000
# Railway's private network DNS. The backend gets a new private address every
# time it restarts; resolving per request (variable proxy_pass + resolver)
# stops nginx from calling the address it saw at startup forever.
resolver [fd12::10] valid=10s ipv6=on;

server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # Never index staging.
    add_header X-Robots-Tag "noindex, nofollow" always;

    location /api/ {
        set $api_upstream ${STAGING_API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Client-side routes (/dashboard/..., /login, ...) all load the SPA.
    location / {
        try_files $uri /index.html;
    }
}
