{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://voice-production-2950.up.railway.app/:path*"
    },
    { "source": "/dashboard", "destination": "/app-shell.html" },
    { "source": "/dashboard/:path*", "destination": "/app-shell.html" },
    { "source": "/admin", "destination": "/app-shell.html" },
    { "source": "/admin/:path*", "destination": "/app-shell.html" },
    { "source": "/login", "destination": "/app-shell.html" },
    { "source": "/signup", "destination": "/app-shell.html" },
    { "source": "/forgot-password", "destination": "/app-shell.html" },
    { "source": "/reset-password", "destination": "/app-shell.html" },
    { "source": "/verify-email", "destination": "/app-shell.html" },
    { "source": "/confirm-email-change", "destination": "/app-shell.html" },
    { "source": "/invite/:path*", "destination": "/app-shell.html" },
    { "source": "/404", "destination": "/404.html" }
  ]
}
