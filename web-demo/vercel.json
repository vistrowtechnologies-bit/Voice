{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://voice-production-2950.up.railway.app/:path*"
    },
    {
      "source": "/(dashboard|admin|login|signup|forgot-password|reset-password|invite)(/.*)?",
      "destination": "/app-shell.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
