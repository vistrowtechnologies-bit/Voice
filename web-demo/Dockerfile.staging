# Staging web app (Railway service "web-staging", staging environment only).
#
# Production's web app is on Vercel, and its vercel.json hard-codes the
# production API address plus middleware that bounces other hosts to the
# production site, so a Vercel preview of this code would talk to production.
# This image serves the same SPA build from nginx and proxies /api to the
# staging backend inside the staging environment's private network.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Only the client bundle: staging does not need the SEO prerender step.
ARG VITE_APP_ENV=staging
ENV VITE_APP_ENV=$VITE_APP_ENV
RUN npx tsc -b && npx vite build

FROM nginx:1.27-alpine
# nginx substitutes ${STAGING_API_UPSTREAM} etc. into this template at start.
COPY nginx.staging.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
